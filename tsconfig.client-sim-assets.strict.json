{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "modern/client-web/sim/anim_data_runtime.ts",
    "modern/client-web/sim/entity_layer_runtime.ts",
    "modern/client-web/sim/legacy_actor_frame_runtime.ts",
    "modern/client-web/sim/map_runtime.ts",
    "modern/common/**/*.ts"
  ]
}
