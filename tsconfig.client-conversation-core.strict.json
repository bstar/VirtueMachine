{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "modern/client-web/conversation/archive_runtime.ts",
    "modern/client-web/conversation/dialog_runtime.ts",
    "modern/client-web/conversation/presentation_runtime.ts",
    "modern/client-web/conversation/rules_runtime.ts",
    "modern/client-web/conversation/session_runtime.ts",
    "modern/client-web/conversation/text_runtime.ts",
    "modern/common/**/*.ts"
  ]
}
