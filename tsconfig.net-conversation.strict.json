{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "modern/net/conversation_runtime.ts",
    "modern/net/conversation_runtime_types.ts",
    "modern/client-web/conversation/**/*.ts",
    "modern/common/runtime_contract.ts",
    "modern/common/u6_object_constants.ts",
    "modern/common/u6_object_footprint.ts"
  ]
}
