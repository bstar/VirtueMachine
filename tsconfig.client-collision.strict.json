{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "modern/client-web/sim/collision_runtime.ts",
    "modern/client-web/sim/door_runtime.ts",
    "modern/client-web/sim/map_runtime.ts",
    "modern/client-web/sim/object_footprint_runtime.ts",
    "modern/client-web/sim/object_types_runtime.ts",
    "modern/client-web/tests/collision_runtime_test.ts",
    "modern/client-web/tests/door_runtime_test.ts",
    "modern/client-web/tests/object_footprint_runtime_test.ts",
    "modern/common/**/*.ts"
  ]
}
