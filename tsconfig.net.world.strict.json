{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "modern/net/world_map_runtime.ts",
    "modern/net/world_object_baseline_runtime.ts",
    "modern/net/world_object_collision.ts",
    "modern/net/world_object_policy.ts",
    "modern/net/world_object_state_runtime.ts",
    "modern/net/world_object_types.ts",
    "modern/common/**/*.ts"
  ]
}
