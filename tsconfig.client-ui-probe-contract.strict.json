{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "modern/client-web/ui_probe_contract.ts",
    "modern/client-web/gameplay/mechanics_capability_runtime.ts",
    "modern/client-web/gameplay/verb_capability_runtime.ts",
    "modern/client-web/sim/target_runtime.ts",
    "modern/client-web/ui/inventory_paperdoll_layout_runtime.ts",
    "modern/client-web/ui/message_log_runtime.ts",
    "modern/client-web/ui/panel_scope_runtime.ts",
    "modern/client-web/ui/paperdoll_equipment_runtime.ts",
    "modern/client-web/ui/party_message_runtime.ts",
    "modern/common/**/*.ts"
  ]
}
