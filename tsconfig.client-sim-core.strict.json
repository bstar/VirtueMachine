{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "modern/client-web/sim/command_wire_runtime.ts",
    "modern/client-web/sim/legacy_command_runtime.ts",
    "modern/client-web/sim/queue_runtime.ts",
    "modern/client-web/sim/range_runtime.ts",
    "modern/client-web/sim/sim_utils_runtime.ts",
    "modern/client-web/sim/time_runtime.ts",
    "modern/common/**/*.ts"
  ]
}
