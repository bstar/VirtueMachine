{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "modern/client-web/gameplay/legacy_verb_runtime.ts",
    "modern/client-web/gameplay/mechanics_capability_runtime.ts",
    "modern/client-web/gameplay/verb_capability_runtime.ts",
    "modern/client-web/tests/legacy_verb_runtime_test.ts",
    "modern/client-web/tests/ui_mechanics_capability_runtime_test.ts",
    "modern/client-web/tests/ui_verb_capability_runtime_test.ts",
    "modern/common/**/*.ts"
  ]
}
