{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "modern/client-web/sim/collision_runtime.ts",
    "modern/client-web/sim/legacy_command_runtime.ts",
    "modern/client-web/sim/object_footprint_runtime.ts",
    "modern/client-web/sim/sim_utils_runtime.ts",
    "modern/client-web/sim/target_cursor_runtime.ts",
    "modern/client-web/sim/target_runtime.ts",
    "modern/client-web/ui/input_runtime.ts",
    "modern/client-web/ui/legacy_text_runtime.ts",
    "modern/client-web/ui/legacy_view_tile_runtime.ts",
    "modern/client-web/ui/startup_runtime.ts",
    "modern/common/**/*.ts"
  ]
}
