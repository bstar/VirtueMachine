{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "modern/tools/browser_movement_probe_smoke.ts",
    "modern/tools/generate_ui_probe_fixture.ts",
    "modern/client-web/**/*.ts",
    "modern/common/**/*.ts"
  ],
  "exclude": [
    "modern/client-web/tests/**",
    "modern/common/tests/**",
    "modern/net/tests/**"
  ]
}
