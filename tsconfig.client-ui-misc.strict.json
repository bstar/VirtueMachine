{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "modern/client-web/error_runtime.ts",
    "modern/client-web/ui/cursor_runtime.ts",
    "modern/client-web/ui/legacy_view_tile_runtime.ts",
    "modern/client-web/tests/cursor_runtime_test.ts",
    "modern/client-web/tests/error_runtime_test.ts",
    "modern/client-web/tests/legacy_view_tile_runtime_test.ts",
    "modern/common/**/*.ts"
  ]
}
