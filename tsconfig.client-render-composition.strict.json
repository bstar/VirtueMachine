{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "modern/client-web/legacy_object_order.ts",
    "modern/client-web/render_composition.ts",
    "modern/client-web/tests/render_composition_fixtures.ts",
    "modern/common/**/*.ts"
  ]
}
